% Предположим, что cfgSTABase — ваш конфигурационный объект
% Проверяем, есть ли свойство GuardInterval в cfgSTABase
if isprop(cfgSTABase, 'GuardInterval')
    guardInterval = cfgSTABase.GuardInterval;  % Используем значение из конфигурации
else
    guardInterval = 3.2;  % Стандартное значение 3.2 мкс, если не указано
end

% Исправленный вызов функции wlanHEOFDMInfo
ofdmInfoStruct = wlanHEOFDMInfo('HE-LTF', cfgSTABase.ChannelBandwidth, guardInterval);

% Пример дальнейшего использования
snrVal = snrRange(isnr) - 10*log10(ofdmInfoStruct.FFTLength / ofdmInfoStruct.NumTones);
